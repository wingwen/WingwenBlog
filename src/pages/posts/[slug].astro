---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Window from '../../components/Window.astro';
import PlaceholderBadge from '../../components/PlaceholderBadge.astro';
import { formatPostDate, sortPostsNewestFirst, tagHref, visiblePosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = sortPostsNewestFirst(visiblePosts(await getCollection('posts')));

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const publishedAt = data.pubDate.toISOString().slice(0, 10);
---

<BaseLayout title={data.title} description={data.description} ogType="article">
  <div class="solo-shell">
    <Window title="文章" icon="/images/home/icon-doc.webp" tone="pink">
      <article class="post">
    <p class="post__back">
      <a href="/posts">← 全部文章</a>
    </p>

    <header class="post__header">
      <div class="post__title-row">
        <h1 class="post__title">{data.title}</h1>
        <PlaceholderBadge isPlaceholder={data.isPlaceholder} />
      </div>
      <p class="post__meta">
        <time class="post__date" datetime={publishedAt}>{formatPostDate(data.pubDate)}</time>
      </p>
      {
        data.tags.length > 0 && (
          <ul class="meta-list post__tags" role="list" aria-label="标签">
            {data.tags.map((tag) => (
              <li>
                <a class="post__tag" href={tagHref(tag)}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <p class="post__lede">{data.description}</p>
    </header>

    <div class="post__layout">
      {
        tableOfContents.length > 0 && (
          <nav class="post__toc" aria-label="本文目录">
            <p class="post__toc-title">目录</p>
            <ol class="post__toc-list" role="list">
              {tableOfContents.map((heading) => (
                <li class:list={['post__toc-item', `post__toc-item--depth-${heading.depth}`]}>
                  <a class="post__toc-link" href={`#${heading.slug}`}>
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="prose post__body">
        <Content />
      </div>
    </div>
  </article>
    </Window>
  </div>
</BaseLayout>

<style>
  .post {
    max-width: none;
  }

  .post__back {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .post__back a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .post__back a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .post__header {
    max-width: var(--measure);
    margin-block-start: var(--space-3);
    padding-block-end: var(--space-3);
    border-block-end: 1px solid var(--rule);
  }

  .post__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
  }

  .post__title {
    font-size: var(--step-3);
    font-weight: 400;
  }

  .post__meta {
    margin-block-start: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  .post__tags {
    margin-block-start: var(--space-1);
  }

  .post__tag {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .post__tag:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .post__lede {
    margin-block-start: var(--space-3);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .post__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin-block-start: var(--space-4);
  }

  .post__toc {
    padding-block-start: var(--space-2);
    border-block-start: 1px solid var(--rule);
  }

  .post__toc-title {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }

  .post__toc-list {
    display: grid;
    gap: var(--space-1);
    margin-block-start: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .post__toc-item--depth-3 {
    padding-inline-start: var(--space-2);
  }

  .post__toc-link {
    color: var(--ink-muted);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .post__toc-link:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  /* 宽屏下目录进入第二列，正文与目录各占一格，长标题也不会互相压住。 */
  @media (min-width: 64rem) {
    .post {
      max-width: none;
    }

    .post__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 10.5rem);
      column-gap: var(--space-5);
      align-items: start;
    }

    .post__body {
      grid-column: 1;
      grid-row: 1;
    }

    .post__toc {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: var(--space-3);
      padding-block-start: 0;
      padding-inline-start: var(--space-2);
      border-block-start: 0;
      border-inline-start: 1px solid var(--rule);
    }
  }
</style>
