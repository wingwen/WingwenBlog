---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = '没有找到这个页面。可以从首页、关于、项目或文章重新进入。';
---

<BaseLayout title="页面未找到" description={description}>
  <section class="not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">页面未找到</h1>
    <p class="not-found__text">你要找的页面不存在，或者地址已经变了。可以从下面几个入口重新进入。</p>
    <nav class="not-found__nav" aria-label="站点入口">
      <ul class="not-found__list" role="list">
        <li><a class="not-found__link" href="/">首页</a></li>
        <li><a class="not-found__link" href="/about">关于</a></li>
        <li><a class="not-found__link" href="/projects">项目</a></li>
        <li><a class="not-found__link" href="/posts">文章</a></li>
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    max-width: var(--measure);
  }

  .not-found__code {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    color: var(--ink-muted);
  }

  .not-found__title {
    font-size: var(--step-3);
    font-weight: 400;
  }

  .not-found__text {
    max-width: var(--measure);
  }

  .not-found__nav {
    width: 100%;
    margin-block-start: var(--space-2);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--rule);
  }

  .not-found__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .not-found__link {
    text-decoration-thickness: 1px;
  }

  .not-found__link:hover {
    text-decoration-thickness: 2px;
  }
</style>
