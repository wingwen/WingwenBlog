# 环境变量样例：只有变量名，不含任何真实值。
# 本地开发请写进 .dev.vars（已被 .gitignore 忽略），不要用这个文件。
# 线上的值在 Cloudflare Pages 项目 → Settings → Environment variables 里配置为 Secret。

# DeepSeek API Key。只在服务端函数里读取，不要加 PUBLIC_ 前缀。
DEEPSEEK_API_KEY=

# 允许调用 /api/chat 的来源，逗号分隔，例如 https://wingwen.pages.dev,https://blog.example
ALLOWED_ORIGINS=

# 可选：覆盖模型与网关，默认 https://api.deepseek.com + deepseek-flash
# LLM_BASE_URL=
# LLM_MODEL=
