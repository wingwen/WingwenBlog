---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Window from '../components/Window.astro';
import PostEntry from '../components/PostEntry.astro';
import { formatEntryIndex } from '../lib/format';
import {
  collectTags,
  postHref,
  sortPostsNewestFirst,
  tagHref,
  visiblePosts,
} from '../lib/posts';

const publishedPosts = visiblePosts(await getCollection('posts'));
const posts = sortPostsNewestFirst(publishedPosts);
const tags = collectTags(publishedPosts);

// 文章入口的摘要只描述这个栏目本身，不涉及任何个人经历。
const postsDescription = '文章列表：按发布时间从新到旧排列，同一主题下的条目可以在标签页里找到。';
---

<BaseLayout title="文章" description={postsDescription}>
  <div class="solo-shell">
    <PageHead
      title="文章归档"
      lede="按发布时间从新到旧排列。同一主题下的条目可以在标签页里找到。"
      meta={`共 ${posts.length} 篇 · ${tags.length} 个标签`}
      sticker="/images/home/sticker-cat-calico.webp"
    />

    <Window title="全部文章" icon="/images/home/icon-doc.webp" tone="mint">
      {
        tags.length > 0 && (
          <nav class="tag-index" aria-label="全部标签">
            <ul class="tag-index__list" role="list">
              {tags.map(({ tag, count }) => (
                <li class="tag-index__item">
                  <a class="tag-index__link" href={tagHref(tag)}>
                    {tag}
                  </a>
                  <span class="tag-index__count">{count}</span>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        posts.length > 0 ? (
          <ol class="entry-list" role="list">
            {posts.map((post, position) => (
              <PostEntry
                index={formatEntryIndex(position)}
                href={postHref(post.id)}
                pubDate={post.data.pubDate}
                title={post.data.title}
                description={post.data.description}
                tags={post.data.tags}
                isPlaceholder={post.data.isPlaceholder}
                headingLevel={2}
              />
            ))}
          </ol>
        ) : (
          <p class="posts-index__empty">暂时还没有发布文章。</p>
        )
      }
    </Window>
  </div>
</BaseLayout>

<style>
  .tag-index {
    padding-block-end: 0.9rem;
    margin-block-end: 0.3rem;
    border-block-end: 1px dashed var(--blog-mint-line);
  }

  .tag-index__list {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tag-index__item {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.9rem;
  }

  .tag-index__link {
    text-decoration: none;
  }

  .tag-index__link:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .tag-index__count {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    color: var(--blog-ink-soft);
  }

  .posts-index__empty {
    margin: 0;
    color: var(--blog-ink-soft);
  }
</style>
