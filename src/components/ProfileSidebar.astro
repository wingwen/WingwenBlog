---
import { Image } from 'astro:assets';
import Window from './Window.astro';
import { profile } from '../data/profile';

const portrait = profile.portrait;
const primaryEducation = profile.education[0];

const taglineParts = profile.tagline.split(' · ');

const profileFacts = [
  { label: '坐标', value: profile.location, icon: 'icon-house' },
  {
    label: '专业',
    value: primaryEducation ? `${primaryEducation.major}（${primaryEducation.degree}）` : '',
    icon: 'icon-cap',
  },
  { label: '学校', value: primaryEducation?.school ?? '', icon: 'icon-book' },
  { label: '状态', value: profile.status, icon: 'icon-sparkle' },
].filter((fact) => fact.value);
---

<Window title="个人资料" icon="/images/home/icon-user.webp" tone="pink">
  <div class="profile-head">
    {
      portrait && (
        <Image
          class="profile-avatar"
          src={portrait.src}
          alt={portrait.alt}
          width={200}
          loading="eager"
        />
      )
    }
    <div>
      <span class="profile-alias">{profile.alias}</span>
      <span class="profile-role">
        {taglineParts.map((part) => (
          <>
            <span class="profile-role__part">{part}</span>{' '}
          </>
        ))}
      </span>
    </div>
  </div>

  <p class="profile-intro">{profile.siteIntro}</p>

  <dl class="profile-meta">
    {
      profileFacts.map((fact) => (
        <div>
          <dt>
            <img
              src={`/images/home/${fact.icon}.webp`}
              alt=""
              width="24"
              height="24"
              loading="lazy"
              decoding="async"
            />
            {fact.label}
          </dt>
          <dd>{fact.value}</dd>
        </div>
      ))
    }
  </dl>
</Window>

<Window title="联系我" icon="/images/home/icon-heart.webp" tone="mint">
  <dl class="contact-list">
    <div>
      <dt>
        <img
          src="/images/home/sticker-envelope.webp"
          alt=""
          width="24"
          height="24"
          loading="lazy"
          decoding="async"
        />邮箱
      </dt>
      <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
    </div>
    {
      profile.links.map((link) => (
        <div>
          <dt>
            <img
              src="/images/home/icon-doc.webp"
              alt=""
              width="24"
              height="24"
              loading="lazy"
              decoding="async"
            />
            {link.label}
          </dt>
          <dd>
            <a href={link.href}>{link.href.replace(/^https?:\/\//, '')}</a>
          </dd>
        </div>
      ))
    }
  </dl>
</Window>

<Window title="个人标签" icon="/images/home/icon-sparkle.webp" tone="pink">
  <div class="tags-layout">
    <figure class="sticker sticker--side">
      <img
        src="/images/home/sticker-slime.webp"
        alt=""
        width="520"
        height="520"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <ul class="tag-cloud" role="list">
      {profile.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>

  <div class="notice-note-wrap">
    <span class="notice-note__tape" aria-hidden="true"></span>
    <aside class="notice-note">
      <p class="notice-note__text">
        本网站图片素材均来源于网络，有任何问题请<a href={`mailto:${profile.email}`}>联系我</a>删除
      </p>
      <img
        class="notice-note__miku"
        src="/images/home/sticker-miku.webp"
        alt=""
        width="200"
        height="200"
        loading="lazy"
        decoding="async"
      />
    </aside>
  </div>
</Window>

