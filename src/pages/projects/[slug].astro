---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Window from '../../components/Window.astro';
import PlaceholderBadge from '../../components/PlaceholderBadge.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { displayPeriod, projectHref, sortProjectsNewestFirst } from '../../lib/projects';

export async function getStaticPaths() {
  const sortedProjects = sortProjectsNewestFirst(await getCollection('projects'));

  return sortedProjects.map((project) => ({
    params: { slug: project.id },
    props: {
      project,
      otherProjects: sortedProjects.filter((candidate) => candidate.id !== project.id),
    },
  }));
}

const { project, otherProjects } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const hasLinks = Boolean(data.links && data.links.length > 0);
---

<BaseLayout title={data.title} description={data.summary} ogType="article">
  <div class="solo-shell">
    <Window title="项目详情" icon="/images/home/icon-folder.webp" tone="mint">
      <article class="project">
    <p class="project__back">
      <a href="/projects">← 全部项目</a>
    </p>

    <header class="project__header">
      <div class="project__title-row">
        <h1 class="project__title">
        {data.liveUrl ? (
          <a
            class="project__title-link"
            href={data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${data.title}（在新标签页打开）`}
          >
            {data.title}
          </a>
        ) : (
          data.title
        )}
      </h1>
        <PlaceholderBadge isPlaceholder={data.isPlaceholder} />
      </div>
      <p class="project__meta">
        <span class="project__period">{displayPeriod(project)}</span>
        <span class="project__role">{data.role}</span>
      </p>
      <ul class="meta-list project__stack" role="list" aria-label="技术栈">
        {data.stack.map((item) => <li>{item}</li>)}
      </ul>
      <p class="project__lede">{data.summary}</p>
    </header>

    {
      data.screenshots && data.screenshots.length > 0 && (
        <section class="project__section project__shots" aria-label="系统截图">
          <SectionHeader title="系统截图" />
          {data.screenshots.map((screenshot) => (
            <figure class="project-shot">
              <img
                src={screenshot.src}
                alt={screenshot.alt}
                width={screenshot.width}
                height={screenshot.height}
                loading="lazy"
                decoding="async"
              />
              {screenshot.caption && <figcaption>{screenshot.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )
    }

    <section class="project__section">
      <SectionHeader title="背景" />
      <p class="project__text">{data.background}</p>
    </section>

    <section class="project__section">
      <SectionHeader title="我的职责" />
      <ul class="project__items" role="list">
        {data.responsibilities.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="project__section">
      <SectionHeader title="结果" />
      <ul class="project__items" role="list">
        {data.outcomes.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="prose project__body">
      <Content />
    </section>

    {
      hasLinks && (
        <section class="project__section">
          <SectionHeader title="链接" />
          <ul class="project__links" role="list">
            {data.links?.map((link) => (
              <li>
                <a href={link.href} rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <footer class="project__footer">
      <a class="project__footer-back" href="/projects">← 全部项目</a>
      {
        otherProjects.length > 0 && (
          <nav class="project__other" aria-label="其他项目">
            <ul class="project__other-list" role="list">
              {otherProjects.map((other) => (
                <li>
                  <a href={projectHref(other.id)}>{other.data.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </footer>
  </article>
    </Window>
  </div>
</BaseLayout>

<style>
  .project {
    max-width: none;
  }

  .project__back {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .project__back a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .project__back a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .project__header {
    margin-block-start: var(--space-3);
    padding-block-end: var(--space-3);
    border-block-end: 1px solid var(--rule);
  }

  .project__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
  }

  .project__title {
    font-size: var(--step-3);
    font-weight: 400;
  }

  .project__title-link {
    color: inherit;
    text-decoration: none;
    padding: 0.02em 0.1em;
    margin-inline: -0.1em;
    border-radius: 4px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    transition: background-color 0.18s var(--ease), color 0.18s var(--ease);
  }

  .project__title-link:hover,
  .project__title-link:focus-visible {
    background-color: var(--blog-pink);
    color: var(--blog-pink-text);
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    margin-block-start: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  .project__period::after {
    content: '·';
    margin-inline: var(--space-1);
  }

  .project__stack {
    margin-block-start: var(--space-1);
  }

  .project__shots {
    display: grid;
    gap: 0.9rem;
  }

  .project-shot {
    margin: 0;
  }

  .project-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background-color: #fff;
  }

  .project-shot figcaption {
    margin-block-start: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  .project__lede {
    margin-block-start: var(--space-3);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .project__section,
  .project__body {
    margin-block-start: var(--space-5);
  }

  .project__text {
    margin-block-start: var(--space-2);
    max-width: var(--measure);
  }

  .project__items {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
    padding-inline-start: var(--space-3);
    line-height: 1.85;
  }

  .project__items li::marker {
    color: var(--ink-muted);
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin-block-start: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .project__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--rule);
    font-size: var(--step--1);
  }

  .project__footer-back {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    text-decoration: none;
  }

  .project__footer-back:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .project__other-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding: 0;
    list-style: none;
  }
</style>
