---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogShell from '../components/BlogShell.astro';
import PageHead from '../components/PageHead.astro';
import Window from '../components/Window.astro';
import { profile } from '../data/profile';
import type { EducationItem } from '../data/profile';

const resumeDownload = profile.resume;

function educationMeta(item: EducationItem): string[] {
  const parts = [item.major, item.degree];
  if (item.gpa) {
    parts.push(`GPA ${item.gpa}`);
  }
  return parts;
}

const resumeRequestHref = `mailto:${profile.email}?subject=${encodeURIComponent('简历索取：Wingwen')}`;

// 与首页摘要区分开：首页用简介首句，关于页用所在地与状态。
const aboutDescription = `关于${profile.alias}：${profile.tagline}。现居${profile.location}，${profile.status}。`;

---

<BaseLayout title="关于" description={aboutDescription}>
  <BlogShell>
    <PageHead
      title="About"
      lede="你好👋，我是Wingwen，广州大学计算机专业硕士在读。"
      meta={`${profile.location} · ${profile.status}`}
      sticker="/images/home/3a7a6391394a68bf88f44d7baa0087a5aa57c20c.jpg@240w_240h_1c_1s_!web-avatar-nav.webp"
      stickerWidth={240}
      stickerHeight={240}
    />

    <Window title="教育与经历" icon="/images/home/icon-cap.webp" tone="mint">
      <h3 class="about-subtitle">教育</h3>
      <ol class="cv-list" role="list">
        {
          profile.education.map((item) => (
            <li class="cv-item">
              <div class="cv-item__row">
                <h4 class="cv-item__heading">{item.school}</h4>
                <span class="cv-item__period">{item.period}</span>
              </div>
              <p class="cv-item__sub">
                {educationMeta(item).map((part) => <span>{part}</span>)}
              </p>
            </li>
          ))
        }
      </ol>

      <h3 class="about-subtitle">毕设 / 论文：数据定价</h3>
      <div class="thesis">
        <p class="thesis__lede">
          「训练样本对模型性能的贡献如何量化」展开研究，分别针对时序非平稳数据与通用表格/文本噪声数据设计两套估值方法，并搭建统一实验评估框架，支撑高价值样本筛选与噪声样本发现两类下游任务。
        </p>
        <p class="thesis__label">主要工作</p>
        <ul class="cv-item__points" role="list">
          <li>设计并实现 Temporal-Decay Shapley（TDS）方法族：基础指数时间衰减、幂次改进版、多尺度融合 MS-TDS，在 Shapley 边际贡献框架中显式引入样本时效性。</li>
          <li>提出 SUCV 估值框架：InfoNCE 对比预训练 + 监督梯度 proxy + LoRA 集成降方差，在 Google DVRL 代码库上完成端到端实现与严格消融（w/o InfoNCE、w/o LoRA）。</li>
          <li>构建统一评估协议：Remove-High（高分样本移除曲线）与 Corrupted Discovery（低分噪声发现），对比 LOO、Shapley、TMC-Shapley、Random 等基线。</li>
        </ul>
      </div>

      <h3 class="about-subtitle">实习与工作</h3>
      <ol class="cv-list" role="list">
        {
          profile.experience.map((item) => (
            <li class="cv-item">
              <div class="cv-item__row">
                <h4 class="cv-item__heading">{item.org}</h4>
                <span class="cv-item__period">{item.period}</span>
              </div>
              <p class="cv-item__sub">
                <span>{item.role}</span>
              </p>
              <ul class="cv-item__points" role="list">
                {item.points.map((point) => <li>{point}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
    </Window>

    <Window title="技能与研究" icon="/images/home/icon-book.webp" tone="pink">
      <dl class="about-skills">
        {
          profile.skills.map((group) => (
            <div class="about-skills__group">
              <dt class="about-skills__label">{group.group}</dt>
              <dd class="about-skills__items">
                {group.items.map((item) => (
                  <span>{item}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>

      {
        profile.publications.length > 0 && (
          <>
            <h3 class="about-subtitle">论文</h3>
            <ul class="about-publications" role="list">
              {profile.publications.map((publication) => (
                <li class="about-publication">
                  <cite class="about-publication__title">{publication.title}</cite>
                  <span class="about-publication__venue">{publication.venue}</span>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </Window>

    <Window title="简历" icon="/images/home/icon-doc.webp" tone="mint">
      {
        resumeDownload ? (
          <p class="about-resume">
            <a class="about-action about-action--inline" href={resumeDownload.href} download>
              <span class="about-action__label">PDF 简历</span>
              <span class="about-action__value">{resumeDownload.label} ↓</span>
            </a>
          </p>
        ) : (
          <div class="resume-slot">
            <p class="resume-slot__tag">PDF 待补充</p>
            <p class="resume-slot__text">
              公开版简历 PDF 还没有上传，所以这里先不放下载按钮，也不指向空文件。
              需要完整版时可以直接邮件索取，我会回复最新的一版。
            </p>
            <a class="about-action about-action--inline" href={resumeRequestHref}>
              <span class="about-action__label">邮件索取简历</span>
              <span class="about-action__value">{profile.email} →</span>
            </a>
          </div>
        )
      }
    </Window>
  </BlogShell>
</BaseLayout>

<style>
  .thesis__lede {
    margin: 0.6rem 0 0;
    font-size: 1rem;
    line-height: 1.85;
    color: var(--blog-ink);
  }

  .thesis__label {
    margin: 0.7rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    letter-spacing: 0.05em;
    color: var(--blog-pink-text);
  }

  .about-subtitle {
    margin: 1.1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--blog-pink-text);
  }

  .about-subtitle:first-child {
    margin-block-start: 0;
  }

  .cv-list {
    display: grid;
    padding: 0;
    margin: 0.6rem 0 0;
    list-style: none;
  }

  .cv-item {
    padding-block: 0.7rem;
    border-block-end: 1px dashed var(--blog-pink-line);
  }

  .cv-item:last-child {
    padding-block-end: 0;
    border-block-end: 0;
  }

  .cv-item__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 0.8rem;
  }

  .cv-item__heading {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .cv-item__period {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--blog-ink-soft);
  }

  .cv-item__sub {
    margin: 0.2rem 0 0;
    font-size: 0.86rem;
    color: var(--blog-ink-soft);
  }

  .cv-item__sub > span:not(:last-child)::after {
    content: '·';
    margin-inline: 0.4rem;
  }

  .cv-item__points {
    display: grid;
    max-width: 60ch;
    gap: 0.35rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    line-height: 1.8;
  }

  .cv-item__points > li {
    position: relative;
    padding-inline-start: 1rem;
  }

  .cv-item__points > li::before {
    content: '';
    position: absolute;
    inset-block-start: 0.7em;
    inset-inline-start: 0;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background-color: var(--blog-mint-line);
  }

  .about-skills {
    display: grid;
    gap: 0.7rem;
    margin: 0;
  }

  .about-skills__group {
    display: grid;
    gap: 0.3rem;
  }

  .about-skills__label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    color: var(--blog-pink-text);
  }

  .about-skills__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0;
  }

  .about-skills__items > span {
    padding: 0.06rem 0.5rem;
    border-radius: 999px;
    background-color: var(--blog-mint);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--blog-mint-text);
  }

  .about-skills__group:nth-child(even) .about-skills__items > span {
    background-color: var(--blog-pink);
    color: var(--blog-pink-text);
  }

  .about-publications {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    margin: 0.6rem 0 0;
    list-style: none;
  }

  .about-publication {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.7rem;
  }

  .about-publication__title {
    font-style: italic;
    font-size: 1rem;
  }

  .about-publication__venue {
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background-color: var(--blog-mint);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--blog-mint-text);
  }

  .about-action {
    display: grid;
    gap: 0.15rem;
    min-width: 12rem;
    padding: 0.6rem 0.8rem;
    border: 2px solid var(--blog-mint-line);
    border-radius: 12px;
    background-color: #f2faf7;
    text-decoration: none;
  }

  .about-action:hover {
    background-color: var(--blog-mint);
  }

  .about-action__label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    color: var(--blog-mint-text);
  }

  .about-action__value {
    font-size: 0.92rem;
    color: var(--blog-ink);
    overflow-wrap: anywhere;
  }

  .about-action--inline {
    margin-block-start: 0.2rem;
    min-width: 0;
  }

  .resume-slot {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    padding: 1rem;
    border: 2px dashed var(--blog-mint-line);
    border-radius: 12px;
    background-color: #f2faf7;
  }

  .resume-slot__tag {
    margin: 0;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background-color: var(--blog-mint);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    letter-spacing: 0.04em;
    color: var(--blog-mint-text);
  }

  .resume-slot__text {
    margin: 0;
    max-width: 60ch;
    font-size: 1rem;
    line-height: 1.8;
    color: var(--blog-ink-soft);
  }

  .about-resume a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

</style>
