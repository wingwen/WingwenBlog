---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Window from '../../components/Window.astro';
import PostEntry from '../../components/PostEntry.astro';
import { formatEntryIndex } from '../../lib/format';
import {
  collectTags,
  filterPostsByTag,
  postHref,
  sortPostsNewestFirst,
  visiblePosts,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = sortPostsNewestFirst(visiblePosts(await getCollection('posts')));

  return collectTags(posts).map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      posts: filterPostsByTag(posts, tag),
    },
  }));
}

const { tag, posts } = Astro.props;

// 标签页的摘要点名标签与篇数，保证每个标签页的摘要互不相同。
const tagDescription = `标签「${tag}」下共有 ${posts.length} 篇文章，按发布时间从新到旧排列。`;
---

<BaseLayout title={`标签：${tag}`} description={tagDescription}>
  <div class="solo-shell">
    <p class="tag-page__back">
      <a href="/posts">← 全部文章</a>
    </p>

    <PageHead
      title={`标签：${tag}`}
      lede={`共 ${posts.length} 篇，按发布时间从新到旧排列。`}
      meta="全部标签见文章归档"
      sticker="/images/home/sticker-sakura.webp"
    />

    <Window title="该标签下的文章" icon="/images/home/icon-doc.webp" tone="pink">
      {
        posts.length > 0 ? (
          <ol class="entry-list" role="list">
            {posts.map((post, position) => (
              <PostEntry
                index={formatEntryIndex(position)}
                href={postHref(post.id)}
                pubDate={post.data.pubDate}
                title={post.data.title}
                description={post.data.description}
                tags={post.data.tags}
                isPlaceholder={post.data.isPlaceholder}
                headingLevel={2}
              />
            ))}
          </ol>
        ) : (
          <p class="tag-page__empty">这个标签下暂时没有文章。</p>
        )
      }
    </Window>
  </div>
</BaseLayout>

<style>
  .tag-page__back {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.03em;
  }

  .tag-page__back a {
    color: var(--blog-ink-soft);
    text-decoration: none;
  }

  .tag-page__back a:hover {
    color: var(--blog-pink-text);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .tag-page__empty {
    margin: 0;
    color: var(--blog-ink-soft);
  }
</style>
