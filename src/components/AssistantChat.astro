---
/**
 * 「问问 Wingwen」对话面板。
 *
 * 只负责结构与样式；会话状态与请求逻辑在 src/scripts/assistant-chat.ts，
 * 那边是严格类型的独立模块，能被 astro check 完整覆盖。
 */
import { assistant, features } from '../data/site';
import { profile } from '../data/profile';

const entryName = `问问 ${profile.alias}`;
const isReady = features.aiAssistant;
---

{
  isReady && (
    <dialog id="ask-chat" class="chat" aria-labelledby="ask-chat-title">
      <div class="chat__bar">
        <h2 class="chat__title" id="ask-chat-title">
          <img src="/images/home/icon-sparkle.webp" alt="" width="32" height="32" aria-hidden="true" />
          {entryName}
        </h2>
        <button type="button" class="chat__close" data-chat-close aria-label="关闭对话面板">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>

      <div class="chat__log" data-chat-log aria-live="polite" aria-label="对话内容">
        <p class="chat__bubble chat__bubble--assistant">{assistant.greeting}</p>
      </div>

      <div class="chat__quick" data-chat-quick role="group" aria-label="快捷提问">
        {assistant.quickQuestions.map((question) => (
          <button type="button" class="chat__quick-item" data-quick={question}>
            {question}
          </button>
        ))}
      </div>

      <form class="chat__composer" data-chat-form>
        <label class="chat__label" for="ask-chat-input">你的问题</label>
        <input
          class="chat__input"
          id="ask-chat-input"
          data-chat-input
          type="text"
          maxlength="300"
          autocomplete="off"
          placeholder="问我项目或经历，最多 300 字"
        />
        <button class="chat__send" type="submit" data-chat-send>发送</button>
      </form>

      <p class="chat__status">
        <span data-chat-count>还剩 300 字</span>
        <span class="chat__status-sep" aria-hidden="true">·</span>
        <span>刷新后清空</span>
      </p>
    </dialog>
  )
}

<script>
  import { mountAssistantChat } from '../scripts/assistant-chat';

  mountAssistantChat();
</script>
